    </section>
  </main>

  <!-- Hidden Source Video Element (playsinline critical for mobile) -->
  <video id="sourceVideo" playsinline webkit-playsinline preload="auto" crossorigin="anonymous" class="hidden"></video>

  <script>
    // --- STATE ---
    const state = {
      hasVideo: false,
      fileName: '',
      fileSize: 0,
      duration: 0,
      width: 0,
      height: 0,
      trimStart: 0,
      trimEnd: 15,
      cropX: 50,
      showSafeZone: true,
      isExporting: false,
      previewClipMode: false,
      lastRenderedBlob: null,
      lastRenderedFilename: 'ardhana-clip-9x16.mp4',
      lastRenderedUrl: null,
      subtitles: [
        { id: 1, start: 0.2, end: 3.5, text: 'BITCOIN $1 JUTA DI 2031?!' },
        { id: 2, start: 3.6, end: 7.5, text: 'Ini opini jujur CEO Indodax!' },
        { id: 3, start: 7.6, end: 12.0, text: 'Setuju atau skeptis? Drop komentarmu!' }
      ],
      style: {
        fontFamily: 'Montserrat',
        fontSize: 68,
        textCase: 'uppercase',
        textColor: '#FFFFFF',
        activeColor: '#FACC15',
        strokeColor: '#000000',
        strokeWidth: 8,
        bgColor: '#000000',
        bgOpacity: 0,
        glow: 0,
        popZoom: false,
        posX: 50,
        posY: 74
      }
    };

    // --- DOM ELEMENTS ---
    const video = document.getElementById('sourceVideo');
    const canvas = document.getElementById('previewCanvas');
    const ctx = canvas.getContext('2d');
    const emptyOverlay = document.getElementById('emptyOverlay');

    // --- UTILITIES ---
    function formatTime(sec) {
      if (!isFinite(sec) || sec < 0) sec = 0;
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      const d = Math.floor((sec % 1) * 10);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}.${d}`;
    }

    function formatBytes(bytes) {
      if (!bytes) return '-';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function applyCase(str, mode) {
      if (mode === 'uppercase') return str.toUpperCase();
      if (mode === 'lowercase') return str.toLowerCase();
      if (mode === 'capitalize') {
        return str.replace(/\b\w/g, l => l.toUpperCase());
      }
      return str;
    }

    function hexToRgba(hex, alpha) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    // --- TABS ---
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('bg-[#FA6F05]', 'text-white');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('bg-[#FA6F05]', 'text-white');
        btn.classList.remove('text-slate-400');

        document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById(btn.dataset.tab).classList.remove('hidden');
      });
    });

    // --- LOAD VIDEO FILE ---
    function handleVideoFile(file) {
      if (!file) return;
      const url = URL.createObjectURL(file);
      state.fileName = file.name;
      state.fileSize = file.size;
      video.src = url;
      video.load();
    }

    document.getElementById('videoInput').addEventListener('change', e => handleVideoFile(e.target.files[0]));
    document.getElementById('videoInputEmpty').addEventListener('change', e => handleVideoFile(e.target.files[0]));

    video.addEventListener('loadedmetadata', () => {
      state.hasVideo = true;
      state.duration = video.duration;
      state.width = video.videoWidth;
      state.height = video.videoHeight;
      state.trimStart = 0;
      state.trimEnd = Math.min(30, Math.max(1, Number(video.duration.toFixed(1))));

      document.getElementById('metaName').textContent = state.fileName;
      document.getElementById('metaDuration').textContent = formatTime(state.duration);
      document.getElementById('metaResolution').textContent = `${state.width}×${state.height}`;
      document.getElementById('metaSize').textContent = formatBytes(state.fileSize);

      document.getElementById('trimStart').value = state.trimStart;
      document.getElementById('trimStart').max = state.duration;
      document.getElementById('trimEnd').value = state.trimEnd;
      document.getElementById('trimEnd').max = state.duration;
      document.getElementById('seekBar').max = state.duration;
      document.getElementById('timeTotal').textContent = formatTime(state.duration);

      updateClipDurationBadge();
      emptyOverlay.classList.add('hidden');
      video.currentTime = 0;
    });

    // --- SYNTHETIC DEMO VIDEO GENERATOR (WORKS ON MOBILE TOO) ---
    async function loadDemoVideo() {
      const demoCanvas = document.createElement('canvas');
      demoCanvas.width = 1280;
      demoCanvas.height = 720;
      const dCtx = demoCanvas.getContext('2d');
      const stream = demoCanvas.captureStream(30);

      // Gentle synth tone
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.value = 220;
      gain.gain.value = 0.03;
      const dest = audioCtx.createMediaStreamDestination();
      osc.connect(gain);
      gain.connect(dest);
      osc.start();
      stream.addTrack(dest.stream.getAudioTracks()[0]);

      const recorder = new MediaRecorder(stream);
      const chunks = [];
      recorder.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };

      const btn = document.getElementById('btnLoadDemo');
      btn.textContent = '⏳ Membuat Demo...';
      recorder.start();

      let frame = 0;
      const totalFrames = 180; // 6 seconds
      const timer = setInterval(() => {
        const t = frame / 30;
        const grad = dCtx.createLinearGradient(0, 0, 1280, 720);
        grad.addColorStop(0, '#0f172a');
        grad.addColorStop(1, '#1e293b');
        dCtx.fillStyle = grad;
        dCtx.fillRect(0, 0, 1280, 720);

        // Moving speaker circle
        const cx = 640 + Math.sin(t * 2) * 240;
        dCtx.fillStyle = '#FA6F05';
        dCtx.beginPath();
        dCtx.arc(cx, 330, 110, 0, Math.PI * 2);
        dCtx.fill();

        dCtx.fillStyle = '#FFFFFF';
        dCtx.font = 'bold 48px Inter, sans-serif';
        dCtx.textAlign = 'center';
        dCtx.fillText('PODCAST CRYPTO 2031 DEMO', 640, 540);

        frame++;
        if (frame >= totalFrames) {
          clearInterval(timer);
          recorder.stop();
          osc.stop();
        }
      }, 1000 / 30);

      recorder.onstop = () => {
        btn.textContent = '✨ Video Demo';
        const blob = new Blob(chunks, { type: 'video/webm' });
        const file = new File([blob], 'demo-podcast-16x9.webm', { type: 'video/webm' });
        handleVideoFile(file);
      };
    }

    document.getElementById('btnLoadDemo').addEventListener('click', loadDemoVideo);
    document.getElementById('btnLoadDemoEmpty').addEventListener('click', loadDemoVideo);

    // --- TRIMMER & CROP ---
    function updateClipDurationBadge() {
      const dur = Math.max(0, state.trimEnd - state.trimStart);
      document.getElementById('clipDurationBadge').textContent = `Durasi Klip: ${dur.toFixed(1)}s`;
    }

    document.getElementById('trimStart').addEventListener('input', e => {
      state.trimStart = Math.max(0, Math.min(parseFloat(e.target.value) || 0, state.trimEnd - 0.5));
      updateClipDurationBadge();
    });

    document.getElementById('trimEnd').addEventListener('input', e => {
      state.trimEnd = Math.min(state.duration || 9999, Math.max(parseFloat(e.target.value) || 1, state.trimStart + 0.5));
      updateClipDurationBadge();
    });

    document.getElementById('btnSetStartNow').addEventListener('click', () => {
      state.trimStart = Number(video.currentTime.toFixed(1));
      if (state.trimStart >= state.trimEnd) state.trimEnd = Math.min(state.duration, state.trimStart + 5);
      document.getElementById('trimStart').value = state.trimStart;
      document.getElementById('trimEnd').value = state.trimEnd;
      updateClipDurationBadge();
    });

    document.getElementById('btnSetEndNow').addEventListener('click', () => {
      state.trimEnd = Number(video.currentTime.toFixed(1));
      if (state.trimEnd <= state.trimStart) state.trimStart = Math.max(0, state.trimEnd - 5);
      document.getElementById('trimStart').value = state.trimStart;
      document.getElementById('trimEnd').value = state.trimEnd;
      updateClipDurationBadge();
    });

    const cropSlider = document.getElementById('cropSlider');
    cropSlider.addEventListener('input', e => {
      state.cropX = parseInt(e.target.value, 10);
      document.getElementById('cropPercentLabel').textContent = `${state.cropX}%`;
    });

    document.querySelectorAll('.crop-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        state.cropX = parseInt(btn.dataset.crop, 10);
        cropSlider.value = state.cropX;
        document.getElementById('cropPercentLabel').textContent = `${state.cropX}%`;
      });
    });

    document.getElementById('toggleSafeZone').addEventListener('change', e => {
      state.showSafeZone = e.target.checked;
    });

    // --- AUTO CLIP & SMART SUBJECT DETECT ---
    document.getElementById('btnAutoDetect').addEventListener('click', async () => {
      if (!state.hasVideo) return alert('Silakan upload video terlebih dahulu.');
      const listEl = document.getElementById('autoClipsList');
      listEl.innerHTML = '<p class="text-orange-400 font-semibold animate-pulse">⏳ Menganalisis segmen & fokus gerakan...</p>';

      // Sample center of motion on current frame
      const sampleCanvas = document.createElement('canvas');
      sampleCanvas.width = 160;
      sampleCanvas.height = 90;
      const sCtx = sampleCanvas.getContext('2d');
      sCtx.drawImage(video, 0, 0, 160, 90);
      const data = sCtx.getImageData(0, 0, 160, 90).data;

      let weightedX = 0;
      let totalWeight = 0;
      for (let y = 10; y < 80; y++) {
        for (let x = 0; x < 160; x++) {
          const idx = (y * 160 + x) * 4;
          const lum = (data[idx] + data[idx + 1] + data[idx + 2]) / 3;
          if (lum > 45 && lum < 235) {
            weightedX += x * lum;
            totalWeight += lum;
          }
        }
      }
      if (totalWeight > 0) {
        const detectedPct = Math.round((weightedX / totalWeight / 160) * 100);
        state.cropX = Math.max(15, Math.min(85, detectedPct));
        cropSlider.value = state.cropX;
        document.getElementById('cropPercentLabel').textContent = `${state.cropX}% (Smart Track)`;
      }

      // Generate smart segments (15-45s)
      const dur = state.duration;
      const clips = [];
      if (dur <= 35) {
        clips.push({ title: 'Klip Utama (Full Highlight)', start: 0, end: Number(dur.toFixed(1)), score: '96%' });
      } else {
        const step = Math.min(45, Math.max(20, Math.floor(dur / 4)));
        for (let i = 0; i < 4; i++) {
          const start = Math.min(dur - 15, i * step);
          const end = Math.min(dur, start + 30);
          if (end - start >= 10) {
            clips.push({
              title: `Klip #${i + 1} — Potensi Hook Tinggi`,
              start: Number(start.toFixed(1)),
              end: Number(end.toFixed(1)),
              score: `${94 - i * 4}%`
            });
          }
        }
      }

      listEl.innerHTML = clips.map(c => `
        <button data-start="${c.start}" data-end="${c.end}" class="auto-clip-item w-full text-left p-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 flex items-center justify-between transition">
          <div>
            <p class="font-bold text-slate-100">${c.title}</p>
            <p class="text-[11px] font-mono text-slate-400 mt-0.5">[${formatTime(c.start)} - ${formatTime(c.end)}] (${(c.end - c.start).toFixed(0)} dtk)</p>
          </div>
          <span class="text-xs font-extrabold text-[#FA6F05] bg-orange-500/10 px-2 py-1 rounded">Viral ${c.score}</span>
        </button>
      `).join('');

      document.querySelectorAll('.auto-clip-item').forEach(btn => {
        btn.addEventListener('click', () => {
          state.trimStart = parseFloat(btn.dataset.start);
          state.trimEnd = parseFloat(btn.dataset.end);
          document.getElementById('trimStart').value = state.trimStart;
          document.getElementById('trimEnd').value = state.trimEnd;
          video.currentTime = state.trimStart;
          updateClipDurationBadge();
        });
      });
    });

    // --- SUBTITLE EDITOR & SRT ---
    function renderSubtitleList() {
      const container = document.getElementById('subtitleListContainer');
      document.getElementById('subCountBadge').textContent = `${state.subtitles.length} baris`;

      container.innerHTML = state.subtitles.map((sub, idx) => `
        <div class="bg-slate-950 border border-slate-800 rounded-xl p-2.5 space-y-2">
          <div class="flex items-center gap-2 text-xs">
            <span class="font-mono font-bold text-[#FA6F05]">#${idx + 1}</span>
            <input type="number" step="0.1" value="${sub.start}" data-id="${sub.id}" data-field="start" class="sub-time w-20 bg-slate-900 border border-slate-700 rounded px-2 py-1 font-mono text-xs" />
            <span class="text-slate-500">→</span>
            <input type="number" step="0.1" value="${sub.end}" data-id="${sub.id}" data-field="end" class="sub-time w-20 bg-slate-900 border border-slate-700 rounded px-2 py-1 font-mono text-xs" />
            <button data-id="${sub.id}" class="sub-del ml-auto text-rose-400 hover:text-rose-300 text-xs font-bold px-1.5">✕</button>
          </div>
          <input type="text" value="${sub.text.replace(/"/g, '&quot;')}" data-id="${sub.id}" class="sub-text w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white" />
        </div>
      `).join('');

      document.querySelectorAll('.sub-time').forEach(inp => {
        inp.addEventListener('change', e => {
          const item = state.subtitles.find(s => s.id == e.target.dataset.id);
          if (item) item[e.target.dataset.field] = parseFloat(e.target.value) || 0;
        });
      });

      document.querySelectorAll('.sub-text').forEach(inp => {
        inp.addEventListener('input', e => {
          const item = state.subtitles.find(s => s.id == e.target.dataset.id);
          if (item) item.text = e.target.value;
        });
      });

      document.querySelectorAll('.sub-del').forEach(btn => {
        btn.addEventListener('click', e => {
          state.subtitles = state.subtitles.filter(s => s.id != e.target.dataset.id);
          renderSubtitleList();
        });
      });
    }

    document.getElementById('btnAddSubBlock').addEventListener('click', () => {
      const lastEnd = state.subtitles.length ? state.subtitles[state.subtitles.length - 1].end : state.trimStart;
      state.subtitles.push({
        id: Date.now(),
        start: Number(lastEnd.toFixed(1)),
        end: Number((lastEnd + 2.5).toFixed(1)),
        text: 'Teks subtitle baru...'
      });
      renderSubtitleList();
    });

    // Export SRT
    document.getElementById('btnExportSrt').addEventListener('click', () => {
      const toSrtTime = sec => {
        const h = String(Math.floor(sec / 3600)).padStart(2, '0');
        const m = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
        const s = String(Math.floor(sec % 60)).padStart(2, '0');
        const ms = String(Math.floor((sec % 1) * 1000)).padStart(3, '0');
        return `${h}:${m}:${s},${ms}`;
      };
      const content = state.subtitles.map((s, i) => `${i + 1}\n${toSrtTime(s.start)} --> ${toSrtTime(s.end)}\n${s.text}\n`).join('\n');
      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'ardhana-subtitle.srt';
      a.click();
    });

    // Import SRT / VTT
    document.getElementById('srtInput').addEventListener('change', async e => {
      const file = e.target.files[0];
      if (!file) return;
      const text = await file.text();
      const blocks = text.replace(/\r/g, '').split('\n\n');
      const parsed = [];
      const parseTs = ts => {
        const parts = ts.trim().replace(',', '.').split(':');
        if (parts.length === 3) return (+parts[0]) * 3600 + (+parts[1]) * 60 + parseFloat(parts[2]);
        return (+parts[0]) * 60 + parseFloat(parts[1]);
      };
      blocks.forEach((b, idx) => {
        const lines = b.split('\n').filter(Boolean);
        const timeLine = lines.find(l => l.includes('-->'));
        if (timeLine) {
          const [s, en] = timeLine.split('-->');
          const txtLines = lines.slice(lines.indexOf(timeLine) + 1);
          parsed.push({
            id: Date.now() + idx,
            start: Number(parseTs(s).toFixed(2)),
            end: Number(parseTs(en).toFixed(2)),
            text: txtLines.join(' ')
          });
        }
      });
      if (parsed.length) {
        state.subtitles = parsed;
        renderSubtitleList();
      }
    });

    // Web Speech API Auto Transcribe
    let recognition = null;
    document.getElementById('btnStartSpeech').addEventListener('click', () => {
      const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
      const statusEl = document.getElementById('speechStatus');
      if (!SpeechRec) {
        statusEl.innerHTML = '<span class="text-amber-400">⚠️ Browser HP/perangkat ini tidak mendukung Web Speech API lokal. Gunakan tombol <b>Import .SRT</b> atau <b>Tambah Baris</b> manual.</span>';
        return;
      }
      if (!state.hasVideo) return alert('Upload video dulu sebelum transkripsi.');

      recognition = new SpeechRec();
      recognition.lang = document.getElementById('speechLang').value;
      recognition.continuous = true;
      recognition.interimResults = false;

      let segmentStart = state.trimStart;
      state.subtitles = [];
      renderSubtitleList();

      recognition.onstart = () => {
        statusEl.textContent = '🎙️ Mendengarkan audio video... Pastikan volume media tidak di-mute.';
        document.getElementById('btnStartSpeech').classList.add('hidden');
        document.getElementById('btnStopSpeech').classList.remove('hidden');
        video.currentTime = state.trimStart;
        video.muted = false;
        video.play();
      };

      recognition.onresult = event => {
        for (let i = event.resultIndex; i < event.results.length; i++) {
          if (event.results[i].isFinal) {
            const transcript = event.results[i][0].transcript.trim();
            const now = Number(video.currentTime.toFixed(1));
            if (transcript) {
              state.subtitles.push({
                id: Date.now() + i,
                start: segmentStart,
                end: Math.max(segmentStart + 1.2, now),
                text: transcript
              });
              segmentStart = now;
              renderSubtitleList();
            }
          }
        }
      };

      recognition.onerror = err => {
        statusEl.textContent = `⚠️ Error transkripsi: ${err.error}. Kamu tetap bisa edit subtitle secara manual.`;
      };

      recognition.onend = () => {
        document.getElementById('btnStartSpeech').classList.remove('hidden');
        document.getElementById('btnStopSpeech').classList.add('hidden');
        statusEl.textContent = '✅ Sesi transkripsi selesai.';
      };

      recognition.start();
    });

    document.getElementById('btnStopSpeech').addEventListener('click', () => {
      if (recognition) recognition.stop();
      video.pause();
    });

    // --- STYLE CONTROLS & PRESETS ---
    function syncStyleInputs() {
      document.getElementById('styleFont').value = state.style.fontFamily;
      document.getElementById('styleCase').value = state.style.textCase;
      document.getElementById('styleFontSize').value = state.style.fontSize;
      document.getElementById('valFontSize').textContent = `${state.style.fontSize}px`;
      document.getElementById('styleStrokeWidth').value = state.style.strokeWidth;
      document.getElementById('valStroke').textContent = `${state.style.strokeWidth}px`;
      document.getElementById('styleTextColor').value = state.style.textColor;
      document.getElementById('styleActiveColor').value = state.style.activeColor;
      document.getElementById('styleStrokeColor').value = state.style.strokeColor;
      document.getElementById('styleBgColor').value = state.style.bgColor;
      document.getElementById('styleBgOpacity').value = state.style.bgOpacity;
      document.getElementById('valBgOpacity').textContent = `${state.style.bgOpacity}%`;
      document.getElementById('styleGlow').value = state.style.glow;
      document.getElementById('valGlow').textContent = state.style.glow;
      document.getElementById('stylePosX').value = state.style.posX;
      document.getElementById('valPosX').textContent = `${state.style.posX}%`;
      document.getElementById('stylePosY').value = state.style.posY;
      document.getElementById('valPosY').textContent = `${state.style.posY}%`;
    }

    document.querySelectorAll('.style-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.dataset.preset;
        if (p === 'yellow') {
          Object.assign(state.style, { textColor: '#FFFFFF', activeColor: '#FACC15', strokeColor: '#000000', strokeWidth: 9, bgOpacity: 0, glow: 0, popZoom: false });
        } else if (p === 'neon') {
          Object.assign(state.style, { textColor: '#ECFDF5', activeColor: '#4ADE80', strokeColor: '#064E3B', strokeWidth: 6, bgOpacity: 0, glow: 24, popZoom: false });
        } else if (p === 'badge') {
          Object.assign(state.style, { textColor: '#FFFFFF', activeColor: '#FA6F05', strokeColor: '#000000', strokeWidth: 0, bgColor: '#000000', bgOpacity: 80, glow: 0, popZoom: false });
        } else if (p === 'popup') {
          Object.assign(state.style, { textColor: '#FFFFFF', activeColor: '#38BDF8', strokeColor: '#000000', strokeWidth: 10, bgOpacity: 0, glow: 8, popZoom: true });
        }
        syncStyleInputs();
      });
    });

    document.getElementById('styleFont').addEventListener('change', e => state.style.fontFamily = e.target.value);
    document.getElementById('styleCase').addEventListener('change', e => state.style.textCase = e.target.value);
    document.getElementById('styleFontSize').addEventListener('input', e => {
      state.style.fontSize = +e.target.value;
      document.getElementById('valFontSize').textContent = `${state.style.fontSize}px`;
    });
    document.getElementById('styleStrokeWidth').addEventListener('input', e => {
      state.style.strokeWidth = +e.target.value;
      document.getElementById('valStroke').textContent = `${state.style.strokeWidth}px`;
    });
    document.getElementById('styleTextColor').addEventListener('input', e => state.style.textColor = e.target.value);
    document.getElementById('styleActiveColor').addEventListener('input', e => state.style.activeColor = e.target.value);
    document.getElementById('styleStrokeColor').addEventListener('input', e => state.style.strokeColor = e.target.value);
    document.getElementById('styleBgColor').addEventListener('input', e => state.style.bgColor = e.target.value);
    document.getElementById('styleBgOpacity').addEventListener('input', e => {
      state.style.bgOpacity = +e.target.value;
      document.getElementById('valBgOpacity').textContent = `${state.style.bgOpacity}%`;
    });
    document.getElementById('styleGlow').addEventListener('input', e => {
      state.style.glow = +e.target.value;
      document.getElementById('valGlow').textContent = state.style.glow;
    });
    document.getElementById('stylePosX').addEventListener('input', e => {
      state.style.posX = +e.target.value;
      document.getElementById('valPosX').textContent = `${state.style.posX}%`;
    });
    document.getElementById('stylePosY').addEventListener('input', e => {
      state.style.posY = +e.target.value;
      document.getElementById('valPosY').textContent = `${state.style.posY}%`;
    });

    document.querySelectorAll('.pos-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        state.style.posY = +btn.dataset.posy;
        syncStyleInputs();
      });
    });

    // --- PLAYBACK CONTROLS ---
    const seekBar = document.getElementById('seekBar');
    seekBar.addEventListener('input', e => {
      if (!state.hasVideo) return;
      video.currentTime = parseFloat(e.target.value);
    });

    document.getElementById('btnPlayPause').addEventListener('click', () => {
      if (!state.hasVideo) return;
      state.previewClipMode = false;
      if (video.paused) video.play();
      else video.pause();
    });

    document.getElementById('btnPreviewClip').addEventListener('click', () => {
      if (!state.hasVideo) return;
      state.previewClipMode = true;
      video.currentTime = state.trimStart;
      video.play();
    });

    // --- CANVAS RENDERER (9:16 CROP + SUBTITLES + KARAOKE) ---
    function drawFrameToCanvas(targetCtx, targetW, targetH, currentTime, includeOverlayUI) {
      targetCtx.fillStyle = '#000000';
      targetCtx.fillRect(0, 0, targetW, targetH);

      if (state.hasVideo && video.readyState >= 2) {
        const vw = video.videoWidth;
        const vh = video.videoHeight;
        const targetRatio = targetW / targetH; // 9/16
        const srcRatio = vw / vh;

        let sx = 0, sy = 0, sw = vw, sh = vh;
        if (srcRatio > targetRatio) {
          // Landscape / wider source -> crop horizontally without stretching
          sw = vh * targetRatio;
          const maxOffsetX = vw - sw;
          sx = (state.cropX / 100) * maxOffsetX;
        } else {
          // Taller source -> crop vertically centered
          sh = vw / targetRatio;
          sy = (vh - sh) / 2;
        }
        targetCtx.drawImage(video, sx, sy, sw, sh, 0, 0, targetW, targetH);
      }

      // Draw Active Subtitle with Word-Level Karaoke Highlight
      const activeSub = state.subtitles.find(s => currentTime >= s.start && currentTime <= s.end);
      if (activeSub && activeSub.text.trim()) {
        const scaleFactor = targetW / 1080;
        const st = state.style;
        const rawText = applyCase(activeSub.text.trim(), st.textCase);
        const words = rawText.split(/\s+/);
        const progress = Math.max(0, Math.min(0.999, (currentTime - activeSub.start) / Math.max(0.1, activeSub.end - activeSub.start)));
        const activeWordIdx = Math.floor(progress * words.length);

        const fontSize = Math.round(st.fontSize * scaleFactor);
        targetCtx.font = `900 ${fontSize}px "${st.fontFamily}", sans-serif`;
        targetCtx.textBaseline = 'middle';

        // Word wrap into lines (max width 84% of canvas)
        const maxWidth = targetW * 0.84;
        const lines = [];
        let currentLine = [];
        let currentLineW = 0;
        const spaceW = targetCtx.measureText(' ').width;

        words.forEach((w, idx) => {
          const wWidth = targetCtx.measureText(w).width;
          if (currentLine.length > 0 && currentLineW + spaceW + wWidth > maxWidth) {
            lines.push(currentLine);
            currentLine = [{ word: w, index: idx, width: wWidth }];
            currentLineW = wWidth;
          } else {
            currentLine.push({ word: w, index: idx, width: wWidth });
            currentLineW += (currentLine.length > 1 ? spaceW : 0) + wWidth;
          }
        });
        if (currentLine.length) lines.push(currentLine);

        const lineHeight = fontSize * 1.24;
        const totalBlockH = lines.length * lineHeight;
        const centerX = (st.posX / 100) * targetW;
        const centerY = (st.posY / 100) * targetH;

        // Background Badge Box
        if (st.bgOpacity > 0) {
          let maxLineW = 0;
          lines.forEach(line => {
            const lw = line.reduce((acc, item, i) => acc + item.width + (i > 0 ? spaceW : 0), 0);
            if (lw > maxLineW) maxLineW = lw;
          });
          const padX = 28 * scaleFactor;
          const padY = 18 * scaleFactor;
          const boxW = maxLineW + padX * 2;
          const boxH = totalBlockH + padY * 2;
          const boxX = centerX - boxW / 2;
          const boxY = centerY - boxH / 2;
          const radius = 20 * scaleFactor;

          targetCtx.save();
          targetCtx.fillStyle = hexToRgba(st.bgColor, st.bgOpacity / 100);
          targetCtx.beginPath();
          targetCtx.roundRect(boxX, boxY, boxW, boxH, radius);
          targetCtx.fill();
          targetCtx.restore();
        }

        // Render Each Word
        lines.forEach((line, lineIdx) => {
          const lineW = line.reduce((acc, item, i) => acc + item.width + (i > 0 ? spaceW : 0), 0);
          let cursorX = centerX - lineW / 2;
          const lineY = centerY - totalBlockH / 2 + lineIdx * lineHeight + lineHeight / 2;

          line.forEach(item => {
            const isCurrentWord = item.index === activeWordIdx;
            targetCtx.save();
            const wordCenterX = cursorX + item.width / 2;

            if (isCurrentWord && st.popZoom) {
              targetCtx.translate(wordCenterX, lineY);
              targetCtx.scale(1.16, 1.16);
              targetCtx.translate(-wordCenterX, -lineY);
            }

            if (st.glow > 0) {
              targetCtx.shadowColor = isCurrentWord ? st.activeColor : st.textColor;
              targetCtx.shadowBlur = st.glow * scaleFactor;
            }

            targetCtx.textAlign = 'left';
            if (st.strokeWidth > 0) {
              targetCtx.lineJoin = 'round';
              targetCtx.lineWidth = st.strokeWidth * scaleFactor;
              targetCtx.strokeStyle = st.strokeColor;
              targetCtx.strokeText(item.word, cursorX, lineY);
            }

            targetCtx.fillStyle = isCurrentWord ? st.activeColor : st.textColor;
            targetCtx.fillText(item.word, cursorX, lineY);
            targetCtx.restore();

            cursorX += item.width + spaceW;
          });
        });
      }

      // Safe Zone Overlay (Preview Only, never burned into exported video)
      if (includeOverlayUI && state.showSafeZone) {
        targetCtx.save();
        targetCtx.strokeStyle = 'rgba(250, 111, 5, 0.55)';
        targetCtx.lineWidth = 4;
        targetCtx.setLineDash([16, 12]);
        // Top & Bottom UI zones + Right action buttons zone
        targetCtx.strokeRect(54, 220, targetW - 220, targetH - 640);
        targetCtx.fillStyle = 'rgba(250, 111, 5, 0.85)';
        targetCtx.font = 'bold 26px Inter, sans-serif';
        targetCtx.fillText('SAFE ZONE (TIKTOK / REELS / SHORTS)', 70, 200);
        targetCtx.restore();
      }
    }

    // Main Preview Loop
    function previewLoop() {
      if (state.hasVideo && !state.isExporting) {
        if (state.previewClipMode && video.currentTime >= state.trimEnd) {
          video.pause();
          video.currentTime = state.trimStart;
          state.previewClipMode = false;
        }
        seekBar.value = video.currentTime;
        document.getElementById('timeCurrent').textContent = formatTime(video.currentTime);
      }
      if (!state.isExporting) {
        drawFrameToCanvas(ctx, canvas.width, canvas.height, video.currentTime || 0, true);
      }
      requestAnimationFrame(previewLoop);
    }
    requestAnimationFrame(previewLoop);

    // --- MOBILE-OPTIMIZED VIDEO EXPORT ENGINE ---
    let sharedAudioCtx = null;
    let sharedAudioSource = null;

    document.getElementById('btnExport').addEventListener('click', async () => {
      if (!state.hasVideo) return alert('Silakan upload video terlebih dahulu.');
      if (state.isExporting) return;

      const clipDur = state.trimEnd - state.trimStart;
      if (clipDur <= 0.2) return alert('Durasi klip tidak valid.');

      state.isExporting = true;
      const btnExport = document.getElementById('btnExport');
      const progressBox = document.getElementById('exportProgressBox');
      const progressBar = document.getElementById('exportProgressBar');
      const percentText = document.getElementById('exportPercentText');
      const statusText = document.getElementById('exportStatusText');
      const resultBox = document.getElementById('downloadResultBox');

      btnExport.disabled = true;
      btnExport.classList.add('opacity-50');
      progressBox.classList.remove('hidden');
      resultBox.classList.add('hidden');

      // Setup offscreen export canvas according to chosen resolution
      const [outW, outH] = document.getElementById('exportResolution').value.split('x').map(Number);
      const exportCanvas = document.createElement('canvas');
      exportCanvas.width = outW;
      exportCanvas.height = outH;
      const exportCtx = exportCanvas.getContext('2d');

      // Capture 30fps stream
      const canvasStream = exportCanvas.captureStream(30);

      // Attach audio cleanly (reusing AudioContext so mobile Safari/Chrome doesn't fail on second export)
      try {
        if (!sharedAudioCtx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          sharedAudioCtx = new AudioCtx();
          sharedAudioSource = sharedAudioCtx.createMediaElementSource(video);
        }
        if (sharedAudioCtx.state === 'suspended') {
          await sharedAudioCtx.resume();
        }
        const audioDest = sharedAudioCtx.createMediaStreamDestination();
        sharedAudioSource.connect(audioDest);
        sharedAudioSource.connect(sharedAudioCtx.destination);
        audioDest.stream.getAudioTracks().forEach(t => canvasStream.addTrack(t));
      } catch (e) {
        console.warn('Audio capture fallback:', e);
      }

      // Select best supported MIME type (MP4 preferred for iPhone/Android gallery compatibility, WebM fallback)
      const mimeCandidates = [
        'video/mp4;codecs=avc1.42E01E,mp4a.40.2',
        'video/mp4',
        'video/webm;codecs=vp9,opus',
        'video/webm;codecs=vp8,opus',
        'video/webm'
      ];
      let chosenMime = '';
      for (const m of mimeCandidates) {
        if (window.MediaRecorder && MediaRecorder.isTypeSupported(m)) {
          chosenMime = m;
          break;
        }
      }

      const isMp4 = chosenMime.includes('mp4');
      const fileExt = isMp4 ? 'mp4' : 'webm';
      const outputFilename = `ardhana-clip-9x16.${fileExt}`;

      const recorder = chosenMime
        ? new MediaRecorder(canvasStream, { mimeType: chosenMime, videoBitsPerSecond: outW === 1080 ? 8000000 : 4500000 })
        : new MediaRecorder(canvasStream);

      const chunks = [];
      recorder.ondataavailable = e => {
        if (e.data && e.data.size > 0) chunks.push(e.data);
      };

      // Seek to trimStart before starting
      video.pause();
      video.muted = false;
      video.currentTime = state.trimStart;
      await new Promise(resolve => {
        const onSeeked = () => {
          video.removeEventListener('seeked', onSeeked);
          resolve();
        };
        video.addEventListener('seeked', onSeeked);
      });

      recorder.start(250);
      await video.play();

      const renderPump = () => {
        if (!state.isExporting) return;
        const current = video.currentTime;
        const pct = Math.min(100, Math.max(0, Math.round(((current - state.trimStart) / clipDur) * 100)));
        progressBar.style.width = `${pct}%`;
        percentText.textContent = `${pct}%`;
        statusText.textContent = `Merender (${outW}×${outH})...`;

        drawFrameToCanvas(exportCtx, outW, outH, current, false);
        drawFrameToCanvas(ctx, canvas.width, canvas.height, current, false);

        if (current >= state.trimEnd || video.ended) {
          video.pause();
          recorder.stop();
          return;
        }
        requestAnimationFrame(renderPump);
      };
      requestAnimationFrame(renderPump);

      recorder.onstop = () => {
        state.isExporting = false;
        btnExport.disabled = false;
        btnExport.classList.remove('opacity-50');
        progressBox.classList.add('hidden');

        // Revoke previous URL only after new render completes
        if (state.lastRenderedUrl) {
          URL.revokeObjectURL(state.lastRenderedUrl);
        }

        const finalBlob = new Blob(chunks, { type: chosenMime || `video/${fileExt}` });
        const blobUrl = URL.createObjectURL(finalBlob);

        state.lastRenderedBlob = finalBlob;
        state.lastRenderedFilename = outputFilename;
        state.lastRenderedUrl = blobUrl;

        // Populate Mobile-Safe Result Card
        const outputPlayer = document.getElementById('outputPreviewPlayer');
        outputPlayer.src = blobUrl;

        const directLink = document.getElementById('btnDirectDownload');
        directLink.href = blobUrl;
        directLink.download = outputFilename;

        document.getElementById('outputFileInfo').textContent = `${fileExt.toUpperCase()} • ${formatBytes(finalBlob.size)}`;
        resultBox.classList.remove('hidden');
        resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        // Attempt automatic download on desktop browsers
        const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
        if (!isMobile) {
          directLink.click();
        }
      };
    });

    // --- MOBILE SHARE / SAVE TO GALLERY HANDLER ---
    document.getElementById('btnMobileShareSave').addEventListener('click', async () => {
      if (!state.lastRenderedBlob) return;
      const file = new File([state.lastRenderedBlob], state.lastRenderedFilename, {
        type: state.lastRenderedBlob.type
      });

      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        try {
          await navigator.share({
            files: [file],
            title: 'Ardhana Clip 9:16',
            text: 'Video vertikal 9:16 siap upload'
          });
          return;
        } catch (err) {
          if (err.name === 'AbortError') return;
        }
      }

      // Fallback if Web Share with files isn't supported in current mobile browser
      document.getElementById('btnDirectDownload').click();
    });

    // Init UI
    renderSubtitleList();
    syncStyleInputs();
  </script>
</body>
</html>
