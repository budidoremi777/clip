<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Ardhana Clip 9:16 — Mobile & Desktop Video Clipper</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Bangers&family=Bebas+Neue&family=Inter:wght@400;600;700;800;900&family=Montserrat:wght@400;700;800;900&family=Outfit:wght@400;700;800;900&family=Poppins:wght@400;600;700;800;900&family=Roboto:wght@400;700;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              DEFAULT: '#FA6F05',
              hover: '#E85F00',
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #020617;
      color: #f8fafc;
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    input[type="range"] {
      accent-color: #FA6F05;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #FA6F05;
    }
  </style>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex flex-col">

  <!-- Header -->
  <header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur border-b border-slate-800 px-4 py-3">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-[#FA6F05] flex items-center justify-center font-black text-white shadow-lg shadow-orange-500/20">
          9:16
        </div>
        <div>
          <h1 class="font-extrabold text-base sm:text-lg tracking-tight leading-none">
            Ardhana Clip <span class="text-[#FA6F05]">9:16</span>
          </h1>
          <p class="text-[11px] text-slate-400 mt-0.5">Client-Side Clipper • Mobile & Desktop Ready</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button id="btnLoadDemo" class="text-xs font-semibold px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 transition">
          ✨ Video Demo
        </button>
        <label class="cursor-pointer text-xs font-bold px-3.5 py-2 rounded-lg bg-[#FA6F05] hover:bg-[#E85F00] text-white transition shadow">
          📂 Upload Video
          <input id="videoInput" type="file" accept="video/mp4,video/webm,video/quicktime,video/x-matroska,video/*" class="hidden" />
        </label>
      </div>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-3 sm:p-5 grid grid-cols-1 lg:grid-cols-12 gap-5">

    <!-- Left / Top: 9:16 Live Preview & Export -->
    <section class="lg:col-span-5 flex flex-col items-center">
      <div class="w-full max-w-[360px] bg-slate-900 border border-slate-800 rounded-2xl p-3 shadow-2xl">
        <div class="flex items-center justify-between mb-2 px-1">
          <span class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Live Canvas 9:16
          </span>
          <label class="flex items-center gap-1.5 text-xs text-slate-300 cursor-pointer select-none">
            <input id="toggleSafeZone" type="checkbox" checked class="rounded accent-[#FA6F05]" />
            Safe Zone
          </label>
        </div>

        <!-- 9:16 Aspect Ratio Canvas Wrapper -->
        <div class="relative w-full aspect-[9/16] bg-black rounded-xl overflow-hidden border border-slate-800 shadow-inner">
          <canvas id="previewCanvas" width="1080" height="1920" class="w-full h-full object-contain block"></canvas>

          <!-- Empty State Overlay -->
          <div id="emptyOverlay" class="absolute inset-0 flex flex-col items-center justify-center text-center p-6 bg-slate-950/85">
            <div class="w-14 h-14 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-2xl mb-3">
              🎬
            </div>
            <p class="font-bold text-sm text-white">Belum Ada Video</p>
            <p class="text-xs text-slate-400 mt-1 mb-4">Upload video dari galeri HP / komputer atau coba video demo.</p>
            <div class="flex gap-2">
              <label class="cursor-pointer text-xs font-bold px-3.5 py-2 rounded-lg bg-[#FA6F05] hover:bg-[#E85F00] text-white">
                Pilih Video
                <input id="videoInputEmpty" type="file" accept="video/*" class="hidden" />
              </label>
              <button id="btnLoadDemoEmpty" class="text-xs font-semibold px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700">
                Demo
              </button>
            </div>
          </div>
        </div>

        <!-- Playback Controls -->
        <div class="mt-3 space-y-2">
          <input id="seekBar" type="range" min="0" max="100" step="0.05" value="0" class="w-full h-1.5 bg-slate-800 rounded-lg cursor-pointer" />
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span id="timeCurrent">00:00.0</span>
            <span id="timeTotal">00:00.0</span>
          </div>
          <div class="grid grid-cols-2 gap-2 pt-1">
            <button id="btnPlayPause" class="py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 font-bold text-xs flex items-center justify-center gap-1.5 transition">
              ▶️ Play / Pause
            </button>
            <button id="btnPreviewClip" class="py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-[#FA6F05]/40 text-[#FA6F05] font-bold text-xs flex items-center justify-center gap-1.5 transition">
              🔁 Preview Klip
            </button>
          </div>
        </div>

        <!-- Export Controls -->
        <div class="mt-3 pt-3 border-t border-slate-800 space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <label class="text-[11px] text-slate-400 font-medium">Resolusi Export:</label>
            <select id="exportResolution" class="bg-slate-800 border border-slate-700 text-xs rounded-lg px-2.5 py-1.5 text-slate-200">
              <option value="1080x1920">1080 × 1920 (Full HD)</option>
              <option value="720x1280" selected>720 × 1280 (HP Cepat & Ringan)</option>
            </select>
          </div>

          <button id="btnExport" class="w-full py-3 px-4 rounded-xl bg-[#FA6F05] hover:bg-[#E85F00] active:scale-[0.99] text-white font-extrabold text-sm shadow-lg shadow-orange-500/20 flex items-center justify-center gap-2 transition">
            ⚡ Pangkas & Render Video
          </button>

          <!-- Render Progress Bar -->
          <div id="exportProgressBox" class="hidden bg-slate-950 border border-slate-800 rounded-xl p-3 space-y-1.5">
            <div class="flex justify-between text-xs font-semibold">
              <span id="exportStatusText" class="text-orange-400">Merender video...</span>
              <span id="exportPercentText" class="font-mono text-white">0%</span>
            </div>
            <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
              <div id="exportProgressBar" class="h-full bg-[#FA6F05] transition-all duration-150" style="width: 0%"></div>
            </div>
            <p class="text-[11px] text-slate-400">Jangan kunci layar HP selama proses render berlangsung.</p>
          </div>

          <!-- Mobile-Safe Download & Share Result Card -->
          <div id="downloadResultBox" class="hidden bg-emerald-950/40 border border-emerald-500/40 rounded-xl p-3 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-emerald-300">✅ Video Selesai Dirender!</span>
              <span id="outputFileInfo" class="text-[11px] font-mono text-slate-300"></span>
            </div>

            <video id="outputPreviewPlayer" controls playsinline webkit-playsinline class="w-full max-h-48 rounded-lg bg-black border border-slate-800"></video>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <button id="btnMobileShareSave" class="py-2.5 px-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow">
                📲 Simpan ke Galeri HP
              </button>
              <a id="btnDirectDownload" href="#" download="ardhana-clip-9x16.mp4" class="py-2.5 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 border border-slate-700 text-center">
                ⬇️ Unduh File
              </a>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              💡 <b>Tips iPhone / Android:</b> Jika tombol <i>Unduh File</i> hanya membuka pemutar video, tekan <b>Simpan ke Galeri HP</b> lalu pilih <i>Save Video</i>, atau tekan tahan video di atas → <i>Download / Simpan Video</i>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Right / Bottom: Tabs & Controls -->
    <section class="lg:col-span-7 flex flex-col bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
      <!-- Navigation Tabs -->
      <div class="grid grid-cols-3 bg-slate-950/70 border-b border-slate-800 p-1.5 gap-1.5">
        <button data-tab="tabVideoCrop" class="tab-btn active-tab py-2.5 px-2 rounded-xl text-xs font-bold bg-[#FA6F05] text-white transition">
          1. Video & Crop
        </button>
        <button data-tab="tabSubtitle" class="tab-btn py-2.5 px-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white hover:bg-slate-800 transition">
          2. Auto Subtitle
        </button>
        <button data-tab="tabStyle" class="tab-btn py-2.5 px-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white hover:bg-slate-800 transition">
          3. Gaya & Posisi
        </button>
      </div>

      <!-- TAB 1: VIDEO, TRIMMER, AUTO CLIP & CROP -->
      <div id="tabVideoCrop" class="tab-panel p-4 space-y-5 overflow-y-auto max-h-[75vh]">
        <!-- Video Metadata -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">Informasi Video</h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
            <div class="bg-slate-900 p-2.5 rounded-lg border border-slate-800">
              <span class="text-slate-400 block text-[11px]">Nama File</span>
              <span id="metaName" class="font-semibold truncate block mt-0.5">-</span>
            </div>
            <div class="bg-slate-900 p-2.5 rounded-lg border border-slate-800">
              <span class="text-slate-400 block text-[11px]">Durasi</span>
              <span id="metaDuration" class="font-semibold font-mono block mt-0.5">-</span>
            </div>
            <div class="bg-slate-900 p-2.5 rounded-lg border border-slate-800">
              <span class="text-slate-400 block text-[11px]">Resolusi</span>
              <span id="metaResolution" class="font-semibold font-mono block mt-0.5">-</span>
            </div>
            <div class="bg-slate-900 p-2.5 rounded-lg border border-slate-800">
              <span class="text-slate-400 block text-[11px]">Ukuran</span>
              <span id="metaSize" class="font-semibold font-mono block mt-0.5">-</span>
            </div>
          </div>
        </div>

        <!-- Trimmer -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5 space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">✂️ Pemotong Durasi (Trimmer)</h2>
            <span id="clipDurationBadge" class="text-xs font-mono font-bold text-[#FA6F05] bg-orange-500/10 px-2 py-0.5 rounded">Durasi Klip: 0.0s</span>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-xs text-slate-400 block mb-1">Mulai (detik)</label>
              <div class="flex gap-1.5">
                <input id="trimStart" type="number" min="0" step="0.1" value="0" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono" />
                <button id="btnSetStartNow" title="Set dari posisi playhead" class="px-2.5 py-2 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs font-bold">Now</button>
              </div>
            </div>
            <div>
              <label class="text-xs text-slate-400 block mb-1">Selesai (detik)</label>
              <div class="flex gap-1.5">
                <input id="trimEnd" type="number" min="0.5" step="0.1" value="15" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono" />
                <button id="btnSetEndNow" title="Set dari posisi playhead" class="px-2.5 py-2 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs font-bold">Now</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Crop & Smart Framing -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5 space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">📐 Smart Crop 9:16</h2>
            <span id="cropPercentLabel" class="text-xs font-mono font-bold text-[#FA6F05]">50% (Tengah)</span>
          </div>
          <input id="cropSlider" type="range" min="0" max="100" value="50" class="w-full cursor-pointer" />
          <div class="grid grid-cols-3 gap-2">
            <button data-crop="15" class="crop-preset py-2 px-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold">👈 Kiri (15%)</button>
            <button data-crop="50" class="crop-preset py-2 px-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold">👤 Tengah (50%)</button>
            <button data-crop="85" class="crop-preset py-2 px-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold">Kanan 👉 (85%)</button>
          </div>
        </div>

        <!-- Auto Clip / Smart Detect -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5 space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">✨ Auto Clip & Smart Subject Detect</h2>
              <p class="text-[11px] text-slate-400 mt-0.5">Deteksi otomatis segmen aktif 15–60 detik & fokus subjek.</p>
            </div>
            <button id="btnAutoDetect" class="py-2 px-3.5 rounded-lg bg-[#FA6F05] hover:bg-[#E85F00] text-white font-bold text-xs shadow">
              ✨ Analisis Video
            </button>
          </div>
          <div id="autoClipsList" class="space-y-2 text-xs text-slate-400">
            <p class="italic text-[11px]">Klik "Analisis Video" setelah video dimuat untuk mendapatkan rekomendasi klip.</p>
          </div>
        </div>
      </div>

      <!-- TAB 2: AUTO SUBTITLE & TIMELINE EDITOR -->
      <div id="tabSubtitle" class="tab-panel hidden p-4 space-y-4 overflow-y-auto max-h-[75vh]">
        <!-- Auto Speech Recognition & SRT -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5 space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">🎙️ Auto Subtitle Generator</h2>
            <select id="speechLang" class="bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs">
              <option value="id-ID">🇮🇩 Bahasa Indonesia</option>
              <option value="en-US">🇺🇸 English (US)</option>
              <option value="ms-MY">🇲🇾 Bahasa Melayu</option>
            </select>
          </div>

          <div class="flex flex-wrap gap-2">
            <button id="btnStartSpeech" class="flex-1 py-2.5 px-3 rounded-lg bg-[#FA6F05] hover:bg-[#E85F00] text-white font-bold text-xs">
              🎙️ Mulai Auto-Transkrip Klip
            </button>
            <button id="btnStopSpeech" class="hidden py-2.5 px-3 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs">
              ⏹️ Stop
            </button>
          </div>

          <p id="speechStatus" class="text-[11px] text-slate-400">
            Memutar klip secara lokal dan menangkap suara menjadi subtitle otomatis (dukungan terbaik di Chrome Android/Desktop).
          </p>

          <div class="flex flex-wrap gap-2 pt-1 border-t border-slate-800">
            <label class="cursor-pointer py-2 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold">
              📥 Import .SRT / .VTT
              <input id="srtInput" type="file" accept=".srt,.vtt" class="hidden" />
            </label>
            <button id="btnExportSrt" class="py-2 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold">
              📤 Export .SRT
            </button>
            <button id="btnAddSubBlock" class="py-2 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-[#FA6F05]">
              ➕ Tambah Baris
            </button>
          </div>
        </div>

        <!-- Subtitle List Editor -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Daftar Subtitle & Karaoke Timing</h3>
            <span id="subCountBadge" class="text-[11px] font-mono text-slate-400">0 baris</span>
          </div>
          <div id="subtitleListContainer" class="space-y-2.5"></div>
        </div>
      </div>

      <!-- TAB 3: STYLING, TYPOGRAPHY & POSITION -->
      <div id="tabStyle" class="tab-panel hidden p-4 space-y-4 overflow-y-auto max-h-[75vh]">
        <!-- Viral TikTok Presets -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5 space-y-2.5">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">🔥 Preset Viral TikTok / Reels</h2>
          <div class="grid grid-cols-2 gap-2">
            <button data-preset="yellow" class="style-preset py-2.5 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-bold text-left">
              🟡 Yellow Highlight
            </button>
            <button data-preset="neon" class="style-preset py-2.5 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-bold text-left">
              🟩 Green Neon Glow
            </button>
            <button data-preset="badge" class="style-preset py-2.5 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-bold text-left">
              ⬛ Black Box Badge
            </button>
            <button data-preset="popup" class="style-preset py-2.5 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-bold text-left">
              💥 Pop-up Zoom
            </button>
          </div>
        </div>

        <!-- Typography -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5 space-y-3">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">🔤 Tipografi & Warna</h2>
          <div class="grid grid-cols-2 gap-3 text-xs">
            <div>
              <label class="text-slate-400 block mb-1">Font Family</label>
              <select id="styleFont" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-2">
                <option value="Montserrat" selected>Montserrat</option>
                <option value="Poppins">Poppins</option>
                <option value="Anton">Anton</option>
                <option value="Bebas Neue">Bebas Neue</option>
                <option value="Bangers">Bangers</option>
                <option value="Outfit">Outfit</option>
                <option value="Inter">Inter</option>
                <option value="Roboto">Roboto</option>
                <option value="Impact">Impact</option>
                <option value="Arial">Arial</option>
              </select>
            </div>
            <div>
              <label class="text-slate-400 block mb-1">Text Case</label>
              <select id="styleCase" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-2">
                <option value="uppercase" selected>UPPERCASE</option>
                <option value="normal">Normal</option>
                <option value="capitalize">Capitalize</option>
                <option value="lowercase">lowercase</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs">
            <div>
              <label class="text-slate-400 flex justify-between mb-1">
                <span>Ukuran Font</span><span id="valFontSize" class="font-mono text-[#FA6F05]">68px</span>
              </label>
              <input id="styleFontSize" type="range" min="24" max="130" value="68" class="w-full" />
            </div>
            <div>
              <label class="text-slate-400 flex justify-between mb-1">
                <span>Tebal Stroke</span><span id="valStroke" class="font-mono text-[#FA6F05]">8px</span>
              </label>
              <input id="styleStrokeWidth" type="range" min="0" max="15" value="8" class="w-full" />
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 text-xs">
            <div>
              <label class="text-slate-400 block mb-1">Warna Teks</label>
              <input id="styleTextColor" type="color" value="#FFFFFF" class="w-full h-9 rounded bg-slate-900 border border-slate-700 cursor-pointer" />
            </div>
            <div>
              <label class="text-slate-400 block mb-1">Kata Aktif</label>
              <input id="styleActiveColor" type="color" value="#FACC15" class="w-full h-9 rounded bg-slate-900 border border-slate-700 cursor-pointer" />
            </div>
            <div>
              <label class="text-slate-400 block mb-1">Warna Stroke</label>
              <input id="styleStrokeColor" type="color" value="#000000" class="w-full h-9 rounded bg-slate-900 border border-slate-700 cursor-pointer" />
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 text-xs pt-1">
            <div>
              <label class="text-slate-400 block mb-1">Warna Box</label>
              <input id="styleBgColor" type="color" value="#000000" class="w-full h-9 rounded bg-slate-900 border border-slate-700 cursor-pointer" />
            </div>
            <div>
              <label class="text-slate-400 flex justify-between mb-1">
                <span>Opacity Box</span><span id="valBgOpacity" class="font-mono">0%</span>
              </label>
